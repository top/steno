<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Steno</string>
    <key>CFBundleDisplayName</key>
    <string>Steno</string>
    <key>CFBundleExecutable</key>
    <string>Steno</string>
    <key>CFBundleIdentifier</key>
    <string>local.steno</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- The one place the version is maintained: the release workflow reads
         CFBundleShortVersionString and publishes that as the tag, so bumping it
         here is what ships a new release. -->
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Uses the microphone while enabled, sends segments to your selected STT provider, and stores transcripts only.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Used for system speech recognition only when Apple System Speech is selected.</string>
</dict>
</plist>
